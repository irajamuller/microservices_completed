package com.store.gateway;

import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;
import org.springframework.security.config.annotation.web.reactive.EnableWebFluxSecurity;
import org.springframework.security.config.web.server.SecurityWebFiltersOrder;
import org.springframework.security.config.web.server.ServerHttpSecurity;
import org.springframework.security.web.server.SecurityWebFilterChain;

@Configuration
@EnableWebFluxSecurity
public class SecurityConfig {

	private final JwtAuthFilter jwtAuthFilter;

    public SecurityConfig(JwtAuthFilter jwtAuthFilter) {
        this.jwtAuthFilter = jwtAuthFilter;
    }
    
    @Bean
    public SecurityWebFilterChain securityWebFilterChain(ServerHttpSecurity http) {
    	return http
    	        .csrf(ServerHttpSecurity.CsrfSpec::disable) // Desativa CSRF para APIs REST
    	        .httpBasic(ServerHttpSecurity.HttpBasicSpec::disable) // Desativa autenticação básica padrão
    	        .formLogin(ServerHttpSecurity.FormLoginSpec::disable) // Desativa formulário de login padrão
    	        .authorizeExchange(exchanges -> exchanges
    	            .pathMatchers("/usuario/**").permitAll() // Permite todas as rotas que começam com /usuario
    	            .anyExchange().authenticated()          // Exige autenticação para o resto
    	        )
    	        .addFilterAt(jwtAuthFilter, SecurityWebFiltersOrder.AUTHENTICATION)
    	        .build();
	}
}
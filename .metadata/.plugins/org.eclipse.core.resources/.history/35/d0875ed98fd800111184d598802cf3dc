package com.store.auditoria.consumer;

import org.springframework.kafka.annotation.KafkaListener;
import org.springframework.stereotype.Component;

import com.store.municipio.evento.MunicipioEvent;

@Component
public class AuditoriaConsumer {
	
	@KafkaListener(topics = MunicipioEvent.TOPIC, groupId = "meu-grupo-consumidor")
    public void ouvirAtualizacao(MunicipioAtualizadoEvent evento) {
        System.out.println("Mensagem recebida do Kafka!");
        
        System.out.println("ID: " + evento.getId());
        System.out.println("Novo Nome: " + evento.getNome());
        System.out.println("Atualizado em: " + evento.getDataAtualizacao());
    }	
}

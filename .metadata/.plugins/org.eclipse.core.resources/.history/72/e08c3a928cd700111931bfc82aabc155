package com.store.gateway.service;

import org.springframework.stereotype.Service;
import org.springframework.web.reactive.function.client.WebClient;

import reactor.core.publisher.Mono;

@Service
public class UsuarioValidacaoService {

    private final WebClient webClient;

    public UsuarioValidacaoService(WebClient.Builder webClientBuilder) {
        this.webClient = webClientBuilder.baseUrl("http://USUARIO-SERVICE").build();
    }

    public Mono<Boolean> isValidToken(String token) {
        return webClient.get()
                .uri("/usuario/token/{token}", token)
                .retrieve()
                .bodyToMono(Boolean.class)
                .onErrorResume(e -> Mono.just(false)); 
    }
}